+    function reorderHyprlandWorkspace(sourceId, targetId) {
+        if (!HyprlandService.luaConfigActive || sourceId <= 0 || targetId <= 0 || sourceId === targetId)
+            return;
+
+        const temporaryId = 2147483647;
+        const moves = [{
+                workspace: sourceId,
+                id: temporaryId
+            }];
+
+        if (sourceId < targetId) {
+            for (let id = sourceId + 1; id <= targetId; id++)
+                moves.push({
+                    workspace: id,
+                    id: id - 1
+                });
+        } else {
+            for (let id = sourceId - 1; id >= targetId; id--)
+                moves.push({
+                    workspace: id,
+                    id: id + 1
+                });
+        }
+
+        moves.push({
+            workspace: temporaryId,
+            id: targetId
+        });
+        for (const move of moves)
+            Hyprland.dispatch(`hl.dsp.workspace.change_id({ workspace = ${move.workspace}, id = ${move.id} })`);
+    }
