--- a/tests/test-antigravity-live.sh
+++ b/tests/test-antigravity-live.sh
@@ -6,9 +6,11 @@
 trap 'rm -rf "$TMP_ROOT"' EXIT
 
 FAKE_BIN="$TMP_ROOT/bin"
-CONFIG_HOME="$TMP_ROOT/.config"
+TEST_HOME="$TMP_ROOT/home"
+CONFIG_HOME="$TEST_HOME/.config"
 DB="$CONFIG_HOME/Antigravity IDE/User/globalStorage/state.vscdb"
-mkdir -p "$FAKE_BIN" "$(dirname "$DB")"
+CLI_TOKEN="$TEST_HOME/.gemini/antigravity-cli/antigravity-oauth-token"
+mkdir -p "$FAKE_BIN" "$(dirname "$DB")" "$(dirname "$CLI_TOKEN")"
 : > "$DB"
 
 export FAKE_CURL_LOG="$TMP_ROOT/curl-argv.log"
@@ -16,6 +18,7 @@
 export FAKE_FETCH_COUNT_FILE="$TMP_ROOT/fetch-count"
 export REFRESH_ONE='1//ABCDEFGHIJKLMNOPQRSTUVWXYZabcdef'
 export REFRESH_TWO='1//zyxwvutsrqponmlkjihgfedcba987654'
+printf '{"token":{"refresh_token":"%s"},"auth_method":"oauth-pkce"}\n' "$REFRESH_TWO" > "$CLI_TOKEN"
 
 cat > "$FAKE_BIN/sqlite3" <<'SH'
 #!/usr/bin/env bash
@@ -24,6 +27,7 @@
 
 cat > "$FAKE_BIN/secret-tool" <<'SH'
 #!/usr/bin/env bash
+[ "${FAKE_SECRET_TOOL_EMPTY:-false}" != "true" ] || exit 1
 printf '{"refresh_token":"%s"}\n' "$REFRESH_TWO"
 SH
 
@@ -116,12 +120,32 @@
 chmod +x "$FAKE_BIN/curl" "$FAKE_BIN/sqlite3" "$FAKE_BIN/secret-tool"
 
 run_adapter() {
-  PATH="$FAKE_BIN:$PATH" \
-    XDG_CONFIG_HOME="$CONFIG_HOME" \
+  HOME="$TEST_HOME" \
+    PATH="$FAKE_BIN:$PATH" \
+    XDG_CONFIG_HOME="${TEST_CONFIG_HOME:-$CONFIG_HOME}" \
     ANTIGRAVITY_API_BASE_URL="https://fake.antigravity.invalid" \
     "$ROOT/providers/get-provider-usage" antigravity ""
 }
 
+EMPTY_CONFIG="$TMP_ROOT/empty-config"
+mkdir -p "$EMPTY_CONFIG"
+: > "$FAKE_CURL_LOG"
+: > "$FAKE_CURL_STDIN"
+rm -f "$FAKE_FETCH_COUNT_FILE"
+CLI_ONLY="$(TEST_CONFIG_HOME="$EMPTY_CONFIG" FAKE_SECRET_TOOL_EMPTY=true run_adapter)"
+printf '%s' "$CLI_ONLY" | jq -e '
+  .[0].provider == "antigravity"
+  and .[0].error == null
+  and (.[0].accounts | length) == 1
+  and .[0].accounts[0].install == "agy CLI"
+  and .[0].accounts[0].email == "two@example.invalid"
+' >/dev/null
+grep -Fxq "$REFRESH_TWO" "$FAKE_CURL_STDIN"
+if grep -Fq "$REFRESH_TWO" "$FAKE_CURL_LOG"; then
+  echo "agy refresh token leaked into curl argv" >&2
+  exit 1
+fi
+
 : > "$FAKE_CURL_LOG"
 : > "$FAKE_CURL_STDIN"
 rm -f "$FAKE_FETCH_COUNT_FILE"
